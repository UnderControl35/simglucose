# Compiled python modules.
*.pyc

# Setuptools distribution folder.
/dist/
/build/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info
/*.egg

# Allow dataset/T1DatasetAnalysis but not all its content
!dataset/T1DatasetAnalysis/
dataset/T1DatasetAnalysis/*

# Allow specific scripts
!dataset/T1DatasetAnalysis/data_analysis.py
!dataset/T1DatasetAnalysis/data_analysis_noisy.py
!dataset/T1DatasetAnalysis/trajectory_creator.py
!dataset/T1DatasetAnalysis/generate_combined_data.sh

# Ignore dataset files
dataset/Datad4rl/*
dataset/Collected/*
/*.csv

# Results folder
/results/
models/*
#models_backup/
exp/

# Ignore wandb file
wandb

# Remove after DT and ODT implementation
decision-transformer/*
!decision-transformer/gym/
!decision-transformer/gym/*
decision-transformer/gym/D4RL/
decision-transformer/gym/data/
decision-transformer/gym/wandb
decision-transformer/gym/wandb/*

